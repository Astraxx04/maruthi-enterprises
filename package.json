{
  "name": "maruthi-enterprises",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed": "node --env-file=.env.local scripts/seed-supabase.mjs",
    "catalogue:pdf": "node catalogue-print/build.mjs",
    "catalogue:html": "node catalogue-print/build.mjs --html",
    "catalogue:images": "node scripts/add-images.mjs",
    "catalogue:import": "node scripts/import-from-pdf.mjs",
    "check:deploy": "node scripts/verify-catalogue.mjs && node --env-file=.env.local scripts/check-deploy.mjs",
    "check:catalogue": "node scripts/verify-catalogue.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "next": "^15.5.29",
    "react": "^19.0.9",
    "react-dom": "^19.0.9",
    "resend": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "mupdf": "^1.28.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
