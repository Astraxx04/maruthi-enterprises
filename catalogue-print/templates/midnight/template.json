{
  "name": "Midnight",
  "description": "Dark and modern: deep navy pages, each photograph on a bright rounded tile, the name in white and pack sizes as teal pills.",
  "sortOrder": 30,
  "assetsFrom": "gold-classic",
  "page": {
    "width": 595.5,
    "height": 842.5,
    "margin": { "top": 70, "right": 36, "bottom": 52, "left": 36 }
  },
  "grid": { "columns": 2, "rows": 3, "columnGap": 16, "rowGap": 16 },
  "card": {
    "titleHeight": 0,
    "showBrand": false,
    "showSizes": true,
    "showDescription": false,
    "imagePadding": 14,
    "titleLengths": { "long": 30, "xlong": 44 }
  },
  "fonts": {
    "googleFamilies": ["Outfit:wght@400;500;600;700;800", "Inter:wght@400;500;600"],
    "title": "'Outfit', 'Helvetica Neue', Arial, sans-serif",
    "body": "'Inter', 'Helvetica Neue', Arial, sans-serif",
    "cover": "'Outfit', 'Helvetica Neue', Arial, sans-serif"
  },
  "colors": { "gold": "#34d3b1", "goldSoft": "#0f1b2b", "ink": "#eef3f8", "muted": "#8a98ab" },
  "flourishes": { "topLeft": false, "bottomRight": false, "width": 0 },
  "cover": { "enabled": true, "showBlessing": false },
  "footer": { "show": true, "format": "{{pageNumber}} / {{totalPages}}" }
}
