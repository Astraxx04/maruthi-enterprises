{
  "name": "Compact List",
  "description": "A denser trade list — three columns by four rows, twelve products per page, with brands shown. Borrows the Gold Classic ornaments.",
  "sortOrder": 50,
  "assetsFrom": "gold-classic",
  "page": {
    "width": 595.5,
    "height": 842.5,
    "margin": {
      "top": 36,
      "right": 36,
      "bottom": 40,
      "left": 36
    }
  },
  "grid": {
    "columns": 3,
    "rows": 4,
    "columnGap": 14,
    "rowGap": 14
  },
  "card": {
    "titleHeight": 30,
    "showBrand": true,
    "showSizes": true,
    "showDescription": false,
    "imagePadding": 6,
    "titleLengths": {
      "long": 16,
      "xlong": 26
    }
  },
  "fonts": {
    "googleFamilies": [
      "Quicksand:wght@500;600;700",
      "Aleo:wght@400;700"
    ],
    "title": "'Quicksand', 'Trebuchet MS', sans-serif",
    "body": "'Aleo', Georgia, serif",
    "cover": "'Quicksand', Georgia, serif"
  },
  "colors": {
    "gold": "#E0A800",
    "goldSoft": "#EFC94C",
    "ink": "#1b1b1b",
    "muted": "#5a5a5a"
  },
  "flourishes": {
    "topLeft": true,
    "bottomRight": true,
    "width": 85
  },
  "cover": {
    "enabled": true,
    "showBlessing": true
  },
  "footer": {
    "show": true,
    "format": "Page {{pageNumber}} of {{totalPages}}"
