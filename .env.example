# ─────────────────────────────────────────────────────────────────────────────
# Maruthi Enterprises — environment variables
# Copy to .env.local for development, and set the same keys in your host's
# dashboard for production. Never commit the filled-in file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ────────────────────────────────────────────────────────────────────
# Used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin (required) ────────────────────────────────────────────────────────
# A single shared password protects /admin. Customers never authenticate.
ADMIN_PASSWORD=change-this-to-a-long-random-password
# Signs the admin session cookie. Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# ── Database & image storage (optional in development) ──────────────────────
# Without these the site reads and writes data/catalogue.json, which works
# locally but NOT on serverless hosting. Configure Supabase for production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# ── Enquiry notifications — email (primary) ─────────────────────────────────
# https://resend.com — free tier covers 3,000 emails/month.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=prabhalchandujm28@gmail.com
# Must be a verified domain in Resend. Falls back to Resend's test sender.
ENQUIRY_FROM_EMAIL=Maruthi Catalogue <catalogue@yourdomain.com>

# ── Enquiry notifications — Telegram (recommended, free) ────────────────────
# 1. Message @BotFather on Telegram, send /newbot, copy the token.
# 2. Add the bot to a group (or message it directly).
# 3. Open https://api.telegram.org/bot<TOKEN>/getUpdates and copy chat.id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Enquiry notifications — generic webhook (optional) ──────────────────────
# Point at WhatsApp Cloud API, Slack, Zapier, n8n — anything accepting JSON.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=

# ── Business details shown on the site (optional) ───────────────────────────
NEXT_PUBLIC_BUSINESS_NAME=Maruthi Enterprises
NEXT_PUBLIC_BUSINESS_EMAIL=prabhalchandujm28@gmail.com
NEXT_PUBLIC_BUSINESS_PHONE=+91 70905 35334
NEXT_PUBLIC_BUSINESS_WHATSAPP=+91 70905 35334
NEXT_PUBLIC_BUSINESS_ADDRESS=Deena Seva School, No. 1, 1st Main Road, Kamala Nagar, Bengaluru 560079
NEXT_PUBLIC_BUSINESS_GSTIN=GST No. 29DNRPP1242Q1Z2
BUSINESS_TIMEZONE=Asia/Kolkata
